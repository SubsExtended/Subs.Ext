<!-- Subs.Ext\Tools\Rating.WPF\Dialogs\SettingsDialog.xaml -->
<UserControl x:Class="Rating.WPF.Dialogs.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="500" Height="500"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                  Margin="10,20,10,0"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                  Header="VLC Media Player path:">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="5"
                           VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                           Text="{Binding VlcPath}">
                </TextBlock>
                <Button Grid.Row="1"
                        Margin="5,0,5,5"
                        Content="Browse..."
                        Width="75" Height="25"
                        HorizontalAlignment="Right"
                        Command="{Binding BrowseVlcCommand}">
                </Button>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
               Margin="10,20,10,0"
               VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
               Header="Temporary files:">

            <Button
                Margin="5"
                Content="Manage Temp Files..."
                Width="150" Height="25"
                HorizontalAlignment="Left"
                Command="{Binding OpenTempFilesCommand}">
            </Button>
        </GroupBox>

        <Button Grid.Row="3" Grid.Column="0"
                Margin="5"
                Content="OK"
                Width="75" Height="25"
                HorizontalAlignment="Center"
                IsDefault="True"
                CommandParameter="OK"
                Command="{Binding CloseDialogCommand}">
        </Button>

        <Button Grid.Row="3" Grid.Column="1"
                Margin="5"
                Content="Cancel"
                Width="75" Height="25"
                HorizontalAlignment="Center"
                IsDefault="False"
                CommandParameter="Cancel"
                Command="{Binding CloseDialogCommand}">
        </Button>

    </Grid>
</UserControl>