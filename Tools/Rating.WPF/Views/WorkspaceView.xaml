<!-- Subs.Ext\Tools\Rating.WPF\Views\WorkspaceView.xaml -->
<UserControl x:Class="Rating.WPF.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:local="clr-namespace:Rating.WPF.Views"
             xmlns:enum="clr-namespace:Rating.WPF.Enums"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="dataFromEnum"
                                MethodName="GetValues"
                                ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enum:FileOperationEnum" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Orientation="Horizontal" Margin="5">
            <Button Margin="5"
                    Padding="10,5"
                    Content="Open Primary File"
                    Command="{Binding OpenSubtitlesFileCommand}"
                    CommandParameter="{x:Static enum:FileRankEnum.Primary}">
            </Button>
            <Button Margin="5"
                    Padding="10,5"
                    Content="Open Secondary File"
                    Command="{Binding OpenSubtitlesFileCommand}"
                    CommandParameter="{x:Static enum:FileRankEnum.Secondary}">
            </Button>
            <Button Margin="5"
                    Padding="10,5"
                    Content="Open Media File"
                    Command="{Binding OpenMediaFileCommand}">
            </Button>
        </StackPanel>

        <GroupBox Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"
                  Margin="5"
                  Header="Primary File">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PrimaryFile}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ContentControl Grid.Row="0"
                                Margin="5"
                                VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                ContentTemplate="{StaticResource PrimaryFileTemplate}"
                                Content="{Binding PrimaryFile}">
                </ContentControl>

                <Grid Grid.Row="1"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Margin="5"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Content="Save as ..."
                            Command="{Binding FileOperationCommand}"
                            CommandParameter="{x:Static enum:FileOperationEnum.PrimarySaveAs}">
                    </Button>

                    <Button Grid.Column="2"
                            Margin="5"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Content="Save"
                            Command="{Binding FileOperationCommand}"
                            CommandParameter="{x:Static enum:FileOperationEnum.PrimarySave}">
                    </Button>

                    <Button Grid.Column="3"
                            Margin="5"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Content="Close"
                            Command="{Binding FileOperationCommand}"
                            CommandParameter="{x:Static enum:FileOperationEnum.PrimaryClose}">
                    </Button>

                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.Column="1"
                  Margin="5"
                  Height="300"
                  Header="VLC Media Player">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="5"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Background="LightGray"
                           FontSize="12"
                           Text="{Binding MediaFilename}"
                           ToolTip="{Binding MediaFilename}">
                </TextBlock>

                <vlc:VideoView Grid.Row="1"
                               VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                               MediaPlayer="{Binding MediaPlayer}">
                </vlc:VideoView>

                <Grid Grid.Row="2"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Margin="5"
                               VerticalAlignment="Center"
                               Text="Audio track: ">
                    </TextBlock>

                    <ComboBox Grid.Column="1"
                              Margin="5"
                              VerticalAlignment="Center"
                              MinWidth="100"
                              ItemsSource="{Binding MediaFileAudioTracks}"
                              SelectedItem="{Binding MediaFileAudioTrackSelectedItem, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Column="3"
                            Margin="5"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Content="Replay Subtitle"
                            Command="{Binding ReplaySubtitleCommand}">
                    </Button>

                    <ToggleButton Grid.Column="4"
                                  Margin="5"
                                  Padding="10,5"
                                  VerticalAlignment="Center"
                                  Content="Mute"
                                  IsChecked="{Binding MediaPlayerIsMuted, Mode=TwoWay}">
                    </ToggleButton>

                    <ToggleButton Grid.Column="5"
                                  Margin="5"
                                  Padding="10,5"
                                  VerticalAlignment="Center"
                                  Content="Pause"
                                  IsChecked="{Binding MediaPlayerIsPaused, Mode=TwoWay}">
                    </ToggleButton>


                </Grid>
            </Grid>
        </GroupBox>
        
        <GroupBox Grid.Row="2" Grid.Column="1"
                  Margin="5"
                  VerticalAlignment="Stretch"
                  Header="Secondary Files">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SecondaryFiles.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ListView Grid.Row="0" Margin="5"
                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      ItemsSource="{Binding SecondaryFiles}"
                      SelectedItem="{Binding SecondaryFilesSelectedItem, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ContentControl VerticalAlignment="Stretch"
                                        ContentTemplate="{StaticResource SecondaryFileTemplate}"
                                        Content="{Binding}">
                            </ContentControl>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1"
                      HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                            Margin="5"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Content="Save all"
                            Command="{Binding FileOperationCommand}"
                            CommandParameter="{x:Static enum:FileOperationEnum.SecondaryAllSave}">
                        </Button>

                        <Button Grid.Column="2"
                            Margin="5"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Content="Close all"
                            Command="{Binding FileOperationCommand}"
                            CommandParameter="{x:Static enum:FileOperationEnum.SecondaryAllClose}">
                        </Button>

                        <Button Grid.Column="3"
                            Margin="5"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Content="Save as ..."
                            Command="{Binding FileOperationCommand}"
                            CommandParameter="{x:Static enum:FileOperationEnum.SecondarySingleSaveAs}">
                        </Button>

                        <Button Grid.Column="4"
                            Margin="5"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Content="Save"
                            Command="{Binding FileOperationCommand}"
                            CommandParameter="{x:Static enum:FileOperationEnum.SecondarySingleSave}">
                        </Button>

                        <Button Grid.Column="5"
                            Margin="5"
                            Padding="10,5"
                            HorizontalAlignment="Right"
                            Content="Close"
                            Command="{Binding FileOperationCommand}"
                            CommandParameter="{x:Static enum:FileOperationEnum.SecondarySingleClose}">
                        </Button>

                    </Grid>
                </Grid>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>