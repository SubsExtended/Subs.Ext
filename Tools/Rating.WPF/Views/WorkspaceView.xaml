<!-- Subs.Ext\Tools\Rating.WPF\Views\WorkspaceView.xaml -->
<UserControl x:Class="Rating.WPF.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:local="clr-namespace:Rating.WPF.Views"
             xmlns:enum="clr-namespace:Rating.WPF.Enums"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" Orientation="Horizontal" Margin="5">
                <Button Margin="5"
                        Content="Open Primary File"
                        Command="{Binding OpenFileCommand}"
                        CommandParameter="{x:Static enum:FileRankEnum.Primary}">
                </Button>
                <Button Margin="5"
                        Content="Open Secondary File"
                        Command="{Binding OpenFileCommand}"
                        CommandParameter="{x:Static enum:FileRankEnum.Secondary}">
                </Button>
            </StackPanel>

            <ContentControl Grid.Row="1" Margin="5"
                            VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            ContentTemplate="{StaticResource PrimaryFileTemplate}"
                            Content="{Binding PrimaryFile}">
            </ContentControl>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="300"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ListView Grid.Row="1" Margin="5"
                      VerticalContentAlignment="Stretch"
                      ItemsSource="{Binding SecondaryFileCollection}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ContentControl VerticalAlignment="Stretch"
                                        ContentTemplate="{StaticResource SecondaryFileTemplate}"
                                        Content="{Binding}">
                        </ContentControl>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

    </Grid>
</UserControl>
